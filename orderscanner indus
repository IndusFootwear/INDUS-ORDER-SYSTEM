<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Order Pad Scanner - Master Converter</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen pb-12">
    <div class="max-w-7xl mx-auto p-4 md:p-8 space-y-6">

        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-indigo-950 via-slate-800 to-indigo-900 border border-slate-700 p-6 rounded-2xl shadow-2xl space-y-4">
            
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 border-b border-slate-700/60 pb-4">
                <div class="space-y-1 w-full lg:w-2/3">
                    <div class="inline-flex items-center gap-2 bg-indigo-500/20 text-indigo-300 text-xs px-3 py-1 rounded-full font-semibold border border-indigo-500/30">
                        <i class="fa-solid fa-store text-indigo-400"></i> Primary Dealer Focus
                    </div>
                    
                    <!-- TOP DEALER NAME DISPLAY / OVERRIDE INPUT -->
                    <div class="pt-2">
                        <label class="block text-[11px] uppercase tracking-wider font-bold text-slate-400 mb-1">
                            Dealer Name / डीलर का नाम
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-building absolute left-3 top-3.5 text-indigo-400 text-sm"></i>
                            <input type="text" id="topDealerInput" placeholder="e.g. VENUS ENTERPRISES / RIDDHI TRADERS" value="VENUS ENTERPRISES" class="w-full pl-9 pr-4 py-2.5 bg-slate-950/90 border border-indigo-500/50 rounded-xl text-lg font-black text-white focus:outline-none focus:ring-2 focus:ring-indigo-400 tracking-wide shadow-inner">
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-3 w-full lg:w-auto justify-start lg:justify-end">
                    <button onclick="downloadExcel()" id="btnExcel" class="flex-1 lg:flex-none bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold py-3 px-5 rounded-xl shadow-lg transition active:scale-95 flex items-center justify-center gap-2 text-sm">
                        <i class="fa-solid fa-file-excel text-lg"></i>
                        <span>Export Excel (.xlsx) / एक्सेल फाइल बनाएं</span>
                    </button>
                    <button onclick="clearAll()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium py-3 px-4 rounded-xl shadow transition text-sm">
                        <i class="fa-solid fa-rotate-left"></i>
                    </button>
                </div>
            </div>

            <!-- Gemini API Key Bar -->
            <div class="bg-slate-950/80 border border-indigo-500/30 rounded-xl p-3 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2 text-slate-300">
                    <i class="fa-solid fa-key text-amber-400 text-sm"></i>
                    <span class="font-bold">Gemini API Key:</span>
                </div>
                
                <div class="flex flex-col sm:flex-row gap-2 flex-1 max-w-xl">
                    <input type="password" id="apiKeyInput" placeholder="Paste AIzaSy... API Key here" class="flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-white font-mono focus:outline-none focus:ring-1 focus:ring-indigo-400">
                    <button onclick="saveApiKey()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-1.5 rounded-lg transition active:scale-95 flex items-center justify-center gap-1">
                        <i class="fa-solid fa-floppy-disk"></i> Save Key
                    </button>
                </div>
            </div>

            <p class="text-slate-400 text-xs">
                Upload order pad pages. The AI automatically extracts article numbers, split colors, sizes, and quantities into a structured Excel sheet.
            </p>
        </div>

        <!-- Bilingual How-To-Use Guide -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden">
            <button onclick="toggleHowTo()" class="w-full flex items-center justify-between px-5 py-3 text-left hover:bg-slate-700/40 transition">
                <span class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-circle-question text-emerald-400"></i>
                    इस्तेमाल कैसे करें (How to Use)
                </span>
                <i id="howToChevron" class="fa-solid fa-chevron-down text-slate-400 transition-transform"></i>
            </button>
            <div id="howToContent" class="hidden px-5 pb-5 grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-300 border-t border-slate-700 pt-4">
                <div>
                    <div class="text-emerald-400 font-bold uppercase tracking-wide text-[10px] mb-2">English</div>
                    <ol class="list-decimal list-inside space-y-1.5">
                        <li>(Optional, recommended) Upload today's <b>Article List Excel/CSV</b> so colours and sizes get checked and auto-corrected against your real stock.</li>
                        <li>Click <b>"Batch Upload Order Pad Pages"</b> and select all your photos at once — 10, 20, or more.</li>
                        <li>Click <b>"Start Batch AI Extraction"</b> and wait — a table will fill in below automatically.</li>
                        <li>Rows highlighted in orange need a quick manual check (unclear handwriting, article not in your list, etc.) — everything else is already corrected.</li>
                        <li>Click <b>"Export Excel (.xlsx)"</b> — the file downloads and opens just like any normal Excel sheet.</li>
                    </ol>
                </div>
                <div>
                    <div class="text-emerald-400 font-bold uppercase tracking-wide text-[10px] mb-2">हिंदी</div>
                    <ol class="list-decimal list-inside space-y-1.5">
                        <li>(वैकल्पिक, पर सुझाया गया) आज की <b>आर्टिकल लिस्ट Excel/CSV</b> अपलोड करें — इससे रंग और साइज़ आपके असली स्टॉक के हिसाब से अपने आप ठीक हो जाएंगे।</li>
                        <li><b>"Batch Upload Order Pad Pages"</b> पर क्लिक करें और अपनी सारी फोटो एक साथ चुनें — 10, 20 या उससे ज़्यादा भी चल जाएगा।</li>
                        <li><b>"Start Batch AI Extraction"</b> पर क्लिक करें और थोड़ा इंतज़ार करें — नीचे टेबल अपने आप भर जाएगी।</li>
                        <li>जिन लाइनों पर <span class="text-amber-400 font-semibold">नारंगी (orange)</span> निशान है, उन्हें एक बार खुद चेक कर लें (हैंडराइटिंग साफ़ नहीं थी, या आर्टिकल लिस्ट में नहीं मिला) — बाकी सब पहले से ठीक हो चुका है।</li>
                        <li><b>"Export Excel (.xlsx)"</b> पर क्लिक करें — फाइल डाउनलोड होगी और आम Excel फाइल की तरह ही खुलेगी।</li>
                    </ol>
                </div>
            </div>
        </div>

        <!-- Slim Stats Strip -->
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-5 py-3 flex flex-wrap gap-x-8 gap-y-2 items-center text-xs">
            <div class="flex items-center gap-2">
                <span class="text-slate-500 uppercase tracking-wide">Dealer / डीलर:</span>
                <span class="font-bold text-indigo-300" id="kpiDealerName">VENUS ENTERPRISES</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-slate-500 uppercase tracking-wide">Pages / पेज:</span>
                <span class="font-bold text-sky-400" id="statFilesCount">0</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-slate-500 uppercase tracking-wide">Rows / लाइनें:</span>
                <span class="font-bold text-slate-200" id="statRowsCount">0</span>
            </div>
            <button onclick="resplitAllRows()" title="Re-apply the latest colour/size/quantity splitting rules to rows already in the table" class="ml-auto sm:ml-0 bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium px-3 py-1.5 rounded-lg shadow transition text-xs flex items-center gap-1.5 whitespace-nowrap">
                <i class="fa-solid fa-scissors"></i> Fix Splitting / फिर से अलग करें
            </button>
            <div class="flex items-center gap-2 sm:ml-auto">
                <span class="text-slate-500 uppercase tracking-wide">Grand Total / कुल:</span>
                <span class="font-black text-emerald-400 text-base" id="statTotalQty">0</span>
            </div>
        </div>

        <!-- Upload + Scan (unified) -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6">
            <label for="imageInput" class="border-2 border-dashed border-indigo-500/40 hover:border-indigo-400 bg-slate-900/50 hover:bg-slate-900 transition rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer text-center group">
                <i class="fa-solid fa-cloud-arrow-up text-3xl text-indigo-400 group-hover:scale-110 transition mb-2"></i>
                <span class="text-sm font-semibold text-slate-200">Click or Drag & Drop Photos Here / फोटो यहाँ डालें</span>
                <span class="text-[11px] text-slate-500 mt-0.5">10, 20, or more at once — JPG, PNG, HEIC</span>
                <input type="file" id="imageInput" multiple accept="image/*" class="hidden" onchange="handleFilesSelect(event)">
            </label>
            <div id="thumbContainer" class="flex flex-wrap gap-2 max-h-24 overflow-y-auto p-1 mt-3"></div>

            <div class="flex flex-col sm:flex-row gap-3 items-stretch mt-4">
                <button onclick="startBatchScan()" id="btnStartScan" disabled class="flex-1 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold py-3.5 px-4 rounded-xl shadow-lg transition active:scale-95 flex items-center justify-center gap-2 text-sm">
                    <i class="fa-solid fa-bolt"></i>
                    <span>Start Scanning / स्कैन शुरू करें</span>
                </button>
                <span id="badgeStatus" class="self-center text-xs font-bold text-slate-400 whitespace-nowrap px-2">Idle</span>
            </div>
            <div id="progressText" class="text-[11px] text-center text-slate-400 font-mono min-h-[1.5rem] break-words px-2 mt-2"></div>
        </div>

        <!-- Advanced Settings (collapsed by default) -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden">
            <button onclick="toggleSettings()" class="w-full flex items-center justify-between px-5 py-3 text-left hover:bg-slate-700/40 transition">
                <span class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-gear text-amber-400"></i>
                    Settings / सेटिंग्स <span class="text-slate-500 font-normal text-xs">(Article List, Split Mode)</span>
                </span>
                <i id="settingsChevron" class="fa-solid fa-chevron-down text-slate-400 transition-transform"></i>
            </button>
            <div id="settingsContent" class="hidden px-5 pb-5 space-y-5 border-t border-slate-700 pt-4">

                <!-- Article List -->
                <div>
                    <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-1">
                        <i class="fa-solid fa-list-check text-emerald-400"></i> Article List / आर्टिकल लिस्ट
                    </h3>
                    <p class="text-xs text-slate-400 mb-3">
                        Upload today's stock list (CSV/Excel — Article No., Colour, Size columns)
                        any time it changes. Re-uploading fully replaces the old list. Unlisted
                        articles or missing colours are flagged, never treated as an error.
                        <br><span class="text-slate-500">जब भी लिस्ट बदले, दुबारा अपलोड करें — पुरानी अपने आप बदल जाएगी।</span>
                    </p>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <label for="masterListInput" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-xl shadow transition active:scale-95 text-xs flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap">
                            <i class="fa-solid fa-file-arrow-up"></i>
                            <span>Upload Today's List / आज की लिस्ट</span>
                        </label>
                        <input type="file" id="masterListInput" accept=".csv,.xlsx,.xls" class="hidden" onchange="handleMasterListUpload(event)">
                        <button onclick="rematchAllRows()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium px-4 py-2 rounded-xl shadow transition text-xs flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rotate"></i> Re-check All Rows / फिर से जांचें
                        </button>
                    </div>
                    <div id="masterListStatus" class="text-xs text-slate-400 bg-slate-900/60 rounded-lg px-3 py-2 border border-slate-700 mt-2">
                        No article list loaded yet. / अभी कोई लिस्ट अपलोड नहीं है।
                    </div>
                </div>

                <!-- Split Mode -->
                <div>
                    <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-1">
                        <i class="fa-solid fa-shuffle text-amber-400"></i> Quantity Split Mode
                    </h3>
                    <p class="text-xs text-slate-400 mb-3">
                        Multiple numbers on one line can mean "one per colour/size" or "one per
                        dispatch month" — pick which this pad uses, or leave on Auto-detect.
                    </p>
                    <div class="flex flex-col md:flex-row gap-3 items-start md:items-center">
                        <select id="splitModeSelect" onchange="onSplitModeChange()" class="px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-slate-200 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-400">
                            <option value="auto">Auto-detect from image (default)</option>
                            <option value="colour">Colour/Size-wise</option>
                            <option value="month">Month-wise (dispatch schedule)</option>
                        </select>
                        <div id="monthLabelsRow" class="hidden flex-1 flex flex-col sm:flex-row gap-2 items-start sm:items-center">
                            <label class="text-xs text-slate-400 whitespace-nowrap">Month labels:</label>
                            <input type="text" id="monthLabelsInput" value="July,August,September" placeholder="e.g. July,August,September" class="flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-slate-200 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-400">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Extraction Results Table -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden shadow-xl">
            <div class="p-4 bg-slate-800/90 border-b border-slate-700 flex flex-col sm:flex-row justify-between items-center gap-3">
                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <h2 class="text-base font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-table-list text-emerald-400"></i> Extracted Orders Table
                    </h2>
                    <span id="visibleBadge" class="bg-slate-700 text-slate-300 text-xs px-2.5 py-0.5 rounded-full font-mono">0 rows</span>
                </div>
                <div class="w-full sm:w-64 relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                    <input type="text" id="searchInput" onkeyup="filterTable()" placeholder="Search dealer, article, color..." class="w-full pl-8 pr-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
            </div>

            <!-- Find & Replace Bar -->
            <div class="p-3 bg-slate-900/60 border-b border-slate-700 flex flex-col md:flex-row gap-2 items-stretch md:items-center text-xs">
                <div class="flex items-center gap-1.5 text-slate-400 font-semibold whitespace-nowrap">
                    <i class="fa-solid fa-arrow-right-arrow-left text-amber-400"></i> Find &amp; Replace:
                </div>
                <select id="frField" class="px-2 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-slate-200 focus:outline-none focus:ring-1 focus:ring-indigo-400">
                    <option value="all">All fields</option>
                    <option value="article">Article No.</option>
                    <option value="colour">Colour</option>
                    <option value="size">Size</option>
                    <option value="station">Station</option>
                </select>
                <input type="text" id="frFind" placeholder="Find (e.g. wrong text)" class="flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-slate-200 focus:outline-none focus:ring-1 focus:ring-indigo-400">
                <i class="fa-solid fa-arrow-right text-slate-500 hidden md:block self-center"></i>
                <input type="text" id="frReplace" placeholder="Replace with" class="flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-slate-200 focus:outline-none focus:ring-1 focus:ring-indigo-400">
                <label class="flex items-center gap-1.5 text-slate-400 whitespace-nowrap px-1">
                    <input type="checkbox" id="frExact" class="accent-indigo-500"> Exact match only
                </label>
                <button onclick="findReplaceAll()" class="bg-amber-600 hover:bg-amber-500 text-white font-bold px-4 py-1.5 rounded-lg transition active:scale-95 whitespace-nowrap">
                    <i class="fa-solid fa-check-double"></i> Replace All
                </button>
            </div>

            <div class="overflow-x-auto max-h-[550px]">
                <table class="w-full text-left text-xs border-collapse" id="masterTable">
                    <thead class="bg-slate-950 text-slate-300 sticky top-0 z-10 uppercase tracking-wider font-semibold border-b border-slate-700">
                        <tr>
                            <th class="py-3 px-4">Page No.</th>
                            <th class="py-3 px-4">Month</th>
                            <th class="py-3 px-4">Station</th>
                            <th class="py-3 px-4">Article No.</th>
                            <th class="py-3 px-4">Colour</th>
                            <th class="py-3 px-4">Size</th>
                            <th class="py-3 px-4 text-right">Qty</th>
                            <th class="py-3 px-4 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="divide-y divide-slate-700/60 text-slate-300 font-medium">
                        <tr id="emptyRow">
                            <td colspan="8" class="text-center py-12 text-slate-500">
                                <i class="fa-solid fa-folder-open text-3xl mb-2 block"></i>
                                Upload photos above and click "Start Batch AI Extraction" to populate data.
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="bg-slate-950/90 font-bold text-slate-100 border-t border-slate-700 sticky bottom-0">
                        <tr>
                            <td colspan="6" class="py-3 px-4 text-right uppercase text-xs tracking-wider">Grand Total Quantity:</td>
                            <td class="py-3 px-4 text-right text-sm text-emerald-400 font-black" id="footGrandTotal">0</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

    </div>

    <!-- Hidden Canvas for Image Resizing & Compression -->
    <canvas id="conversionCanvas" class="hidden"></canvas>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 bg-indigo-600 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl transition-all duration-300 transform translate-y-20 opacity-0 z-50 flex items-center gap-2">
        <i class="fa-solid fa-circle-info"></i> <span id="toastMsg">Notification</span>
    </div>

    <script>
        const apiKey = ""; // System populates at runtime or fallback to UI input
        let userApiKey = "";
        let uploadedFiles = [];
        let masterRows = [];
        let masterIndex = null; // Map: normalizedArticle -> { original, colours: Set, sizes: Set }

        function onSplitModeChange() {
            const mode = document.getElementById('splitModeSelect').value;
            document.getElementById('monthLabelsRow').classList.toggle('hidden', mode !== 'month');
        }

        function getSplitMode() {
            return document.getElementById('splitModeSelect').value; // 'auto' | 'colour' | 'month'
        }

        function getMonthLabels() {
            return document.getElementById('monthLabelsInput').value
                .split(',').map(s => s.trim()).filter(Boolean);
        }

        // Updated July 2026: Gemini 1.0, 1.5, and 2.0 models are all
        // retired (404 on every call). Current generation is Gemini 3.x.
        const MODEL_SEQUENCE = [
            "gemini-flash-latest",
            "gemini-3.5-flash",
            "gemini-3.1-flash-lite"
        ];

        window.onload = function() {
            const storedKey = localStorage.getItem('gemini_ocr_api_key');
            if (storedKey) {
                userApiKey = storedKey;
                document.getElementById('apiKeyInput').value = storedKey;
            }
        };

        function getActiveApiKey() {
            return apiKey || userApiKey || document.getElementById('apiKeyInput').value.trim();
        }

        function saveApiKey() {
            const keyVal = document.getElementById('apiKeyInput').value.trim();
            if (!keyVal) {
                showToast("Please enter a valid API key.");
                return;
            }
            userApiKey = keyVal;
            localStorage.setItem('gemini_ocr_api_key', keyVal);
            showToast("Gemini API key saved successfully!");
        }

        document.getElementById('topDealerInput').addEventListener('input', function(e) {
            const val = e.target.value.trim() || 'UNKNOWN DEALER';
            setText('kpiDealerName', val);
        });

        function toggleHowTo() {
            const content = document.getElementById('howToContent');
            const chevron = document.getElementById('howToChevron');
            content.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleSettings() {
            const content = document.getElementById('settingsContent');
            const chevron = document.getElementById('settingsChevron');
            content.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleRowFlag(event, rowId) {
            event.stopPropagation();
            const box = document.getElementById(`flagbox-${rowId}`);
            if (!box) return;
            const isHidden = box.classList.contains('hidden');
            // Close any other open flag boxes first
            document.querySelectorAll('[id^="flagbox-"]').forEach(el => el.classList.add('hidden'));
            if (isHidden) box.classList.remove('hidden');
        }
        // Close an open flag dropdown when clicking anywhere else on the page
        document.addEventListener('click', () => {
            document.querySelectorAll('[id^="flagbox-"]').forEach(el => el.classList.add('hidden'));
        });

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        function handleFilesSelect(event) {
            const files = Array.from(event.target.files);
            if (files.length === 0) return;

            files.forEach(file => {
                uploadedFiles.push({
                    id: crypto.randomUUID(),
                    file: file,
                    status: 'pending'
                });
            });

            renderThumbnails();
            updateStats();
            document.getElementById('btnStartScan').disabled = uploadedFiles.length === 0;
            showToast(`Added ${files.length} photo(s). Ready to scan.`);
        }

        function renderThumbnails() {
            const container = document.getElementById('thumbContainer');
            container.innerHTML = '';
            uploadedFiles.forEach((item, index) => {
                const url = URL.createObjectURL(item.file);
